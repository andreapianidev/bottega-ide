{
  "name": "bottega-home",
  "displayName": "Bottega",
  "description": "La plancia di tutti i progetti in corso e delle sessioni Claude Code.",
  "publisher": "andreapiani",
  "version": "0.1.0",
  "license": "MIT",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onWebviewPanel:bottega.plancia"
  ],
  "contributes": {
    "commands": [
      {
        "command": "bottega.openPlancia",
        "title": "Apri la plancia",
        "category": "Bottega",
        "icon": "$(home)"
      },
      {
        "command": "bottega.refresh",
        "title": "Aggiorna",
        "category": "Bottega",
        "icon": "$(refresh)"
      },
      {
        "command": "bottega.claudeHere",
        "title": "Apri Claude Code in questa cartella",
        "category": "Bottega"
      },
      {
        "command": "bottega.openProject",
        "title": "Apri progetto",
        "category": "Bottega"
      },
      {
        "command": "bottega.item.open",
        "title": "Apri in una nuova finestra",
        "category": "Bottega"
      },
      {
        "command": "bottega.item.claude",
        "title": "Nuova sessione Claude",
        "category": "Bottega",
        "icon": "$(sparkle)"
      },
      {
        "command": "bottega.item.finder",
        "title": "Mostra nel Finder",
        "category": "Bottega"
      },
      {
        "command": "bottega.item.xcode",
        "title": "Apri in Xcode",
        "category": "Bottega"
      },
      {
        "command": "bottega.voice.toggle",
        "title": "Accendi o spegni Melissa",
        "category": "Bottega",
        "icon": "$(mic)"
      },
      {
        "command": "bottega.assistant.ask",
        "title": "Chiedi a Melissa",
        "category": "Bottega"
      },
      {
        "command": "bottega.memoria.install",
        "title": "Attiva la memoria per Claude Code",
        "category": "Bottega"
      },
      {
        "command": "bottega.openMelissa",
        "title": "Apri Melissa",
        "category": "Bottega"
      },
      {
        "command": "bottega.openCruscotto",
        "title": "Apri il cruscotto",
        "category": "Bottega",
        "icon": "$(graph)"
      },
      {
        "command": "bottega.voice.converse",
        "title": "Parla con Melissa",
        "category": "Bottega"
      },
      {
        "command": "bottega.openVedetta",
        "title": "Apri la vedetta: regole e Store",
        "category": "Bottega",
        "icon": "$(eye)"
      },
      {
        "command": "bottega.openClienti",
        "title": "Apri le ore per cliente",
        "category": "Bottega"
      },
      {
        "command": "bottega.briefing",
        "title": "Il briefing di oggi",
        "category": "Bottega"
      },
      {
        "command": "bottega.cerca",
        "title": "Dove l'ho già risolto?",
        "category": "Bottega",
        "icon": "$(search)"
      },
      {
        "command": "bottega.continua",
        "title": "Continua un progetto da dove eri",
        "category": "Bottega"
      },
      {
        "command": "bottega.regole.controlla",
        "title": "Ricontrolla le regole",
        "category": "Bottega"
      },
      {
        "command": "bottega.openConnettori",
        "title": "Apri connettori e posta per progetto",
        "category": "Bottega"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "bottega",
          "title": "Bottega",
          "icon": "media/activity.svg"
        },
        {
          "id": "melissa",
          "title": "Melissa",
          "icon": "media/melissa.svg"
        }
      ]
    },
    "views": {
      "bottega": [
        {
          "id": "bottega.live",
          "name": "Sessioni Claude vive"
        },
        {
          "id": "bottega.projects",
          "name": "Progetti"
        }
      ],
      "melissa": [
        {
          "id": "bottega.melissa",
          "name": "Melissa",
          "type": "webview"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "bottega.openPlancia",
          "when": "view == bottega.projects",
          "group": "navigation"
        },
        {
          "command": "bottega.refresh",
          "when": "view == bottega.projects",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "bottega.item.claude",
          "when": "view == bottega.projects",
          "group": "inline"
        },
        {
          "command": "bottega.item.claude",
          "when": "view == bottega.projects",
          "group": "1_main@1"
        },
        {
          "command": "bottega.item.open",
          "when": "view == bottega.projects",
          "group": "1_main@2"
        },
        {
          "command": "bottega.item.xcode",
          "when": "view == bottega.projects && viewItem == project.apple",
          "group": "1_main@3"
        },
        {
          "command": "bottega.item.finder",
          "when": "view == bottega.projects",
          "group": "2_os@1"
        }
      ],
      "commandPalette": [
        {
          "command": "bottega.item.open",
          "when": "false"
        },
        {
          "command": "bottega.item.claude",
          "when": "false"
        },
        {
          "command": "bottega.item.finder",
          "when": "false"
        },
        {
          "command": "bottega.item.xcode",
          "when": "false"
        }
      ],
      "explorer/context": [
        {
          "command": "bottega.claudeHere",
          "when": "explorerResourceIsFolder",
          "group": "navigation@99"
        }
      ]
    },
    "keybindings": [
      {
        "command": "bottega.openPlancia",
        "key": "cmd+shift+h"
      },
      {
        "command": "bottega.claudeHere",
        "key": "cmd+alt+c"
      }
    ],
    "configuration": {
      "title": "Bottega",
      "properties": {
        "bottega.roots": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "~/prototipi",
            "~/Library/Mobile Documents/com~apple~CloudDocs/Prototipi",
            "~/Library/Mobile Documents/com~apple~CloudDocs/Avo Agency",
            "~/Library/Mobile Documents/com~apple~CloudDocs/Progetti xCode"
          ],
          "description": "Cartelle che contengono i progetti. Ogni sottocartella diretta e' un progetto."
        },
        "bottega.ignore": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "^_",
            "^\\.",
            "backup",
            "node_modules"
          ],
          "description": "Espressioni regolari: le cartelle che corrispondono non vengono mostrate."
        },
        "bottega.claudeCommand": {
          "type": "string",
          "default": "claude",
          "description": "Comando con cui avviare Claude Code nel terminale."
        },
        "bottega.openOnStartup": {
          "type": "boolean",
          "default": true,
          "description": "Apre la plancia quando la finestra parte senza cartella."
        },
        "bottega.installClaudeExtension": {
          "type": "boolean",
          "default": true,
          "description": "Installa l'estensione ufficiale Claude Code da Open VSX se manca."
        },
        "bottega.nucleoPath": {
          "type": "string",
          "default": "",
          "description": "Percorso dell'eseguibile del Nucleo nativo. Vuoto: lo cerca dentro la Bottega e in ~/prototipi/Bottega/nucleo."
        },
        "bottega.jobs.maxParallel": {
          "type": [
            "string",
            "number"
          ],
          "default": "auto",
          "description": "Quanti lavori in parallelo. \"auto\" si adatta alla pressione di memoria e alla temperatura del Mac (3, 2 o 1); oppure un numero fisso."
        },
        "bottega.voice.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Accende Melissa, l'assistente a voce."
        },
        "bottega.voice.hotkey": {
          "type": "string",
          "default": "option+space",
          "description": "Scorciatoia globale di Melissa. Un tocco avvia o chiude la conversazione, tenerla premuta parla una volta sola."
        },
        "bottega.voice.model": {
          "type": "string",
          "default": "eleven_v4_turbo",
          "description": "Il modello di voce usato dal Nucleo per la sintesi vocale di Melissa."
        },
        "bottega.voice.orbAlwaysVisible": {
          "type": "boolean",
          "default": true,
          "description": "Con la sfera sullo schermo (bottega.voice.sfera = schermo): la tiene sempre visibile, piccola, quando Melissa non parla."
        },
        "bottega.italiano": {
          "type": "boolean",
          "default": true,
          "description": "Al primo avvio installa il pacchetto di lingua italiana e mette VS Code in italiano."
        },
        "bottega.voice.sfera": {
          "type": "string",
          "enum": [
            "ide",
            "schermo"
          ],
          "enumDescriptions": [
            "La sfera di Melissa vive dentro la Bottega: barra laterale e barra di stato. Non copre le altre app.",
            "La sfera galleggia sullo schermo, sopra tutte le finestre, anche con la Bottega in secondo piano."
          ],
          "default": "ide",
          "description": "Dove sta la sfera di Melissa."
        },
        "bottega.briefing.voce": {
          "type": "boolean",
          "default": true,
          "description": "Alla prima apertura della giornata Melissa dice il briefing a voce (una volta sola). Spento: resta la card nella Home."
        },
        "bottega.notte.permessi": {
          "type": "string",
          "enum": [
            "default",
            "acceptEdits",
            "auto",
            "bypassPermissions"
          ],
          "default": "acceptEdits",
          "enumDescriptions": [
            "Claude chiede il permesso per ogni modifica e comando: di notte si ferma subito.",
            "Claude modifica i file da solo, ma si ferma e ti aspetta per i comandi che non sono già permessi.",
            "Claude decide da solo cosa è sicuro e chiede solo per il resto.",
            "Claude fa tutto da solo, comandi compresi. Il preambolo vieta comunque push e pubblicazioni."
          ],
          "description": "Con quali permessi partono i lavori della notte."
        },
        "bottega.consigli.apple": {
          "type": "boolean",
          "default": true,
          "description": "I consigli della Home li scrive Apple Intelligence sul Mac. Spento: consigli fissi ricavati dalle regole."
        },
        "bottega.connettori.mappa": {
          "type": "object",
          "default": {},
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "description": "Connettori di Claude Code in piu' per le capacita' della Bottega, per esempio { \"posta\": [\"mio-server-imap\"] }. Un nome esatto o un'espressione regolare tra barre. Si aggiungono alla mappa di base."
        },
        "bottega.connettori.modello": {
          "type": "string",
          "default": "haiku",
          "description": "Il modello di Claude Code usato per le deleghe ai connettori di claude.ai (Gmail, Calendar, Vercel)."
        },
        "bottega.connettori.tettoGiornalieroUsd": {
          "type": "number",
          "default": 1,
          "minimum": 0,
          "description": "Spesa massima al giorno, in dollari, per le deleghe a Claude Code. Raggiunto il tetto, le deleghe aspettano il giorno dopo."
        },
        "bottega.posta.aggiornaOgniMinuti": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "description": "Ogni quanti minuti aggiornare la posta dal server di posta locale (gratis). 0: solo su richiesta."
        },
        "bottega.posta.gmailOgniMinuti": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "description": "Con l'aggiornamento automatico acceso, ogni quanti minuti cercare anche in Gmail con una delega a Claude Code (a pagamento, almeno 120). 0: Gmail solo su richiesta."
        },
        "bottega.posta.giorni": {
          "type": "number",
          "default": 7,
          "minimum": 1,
          "maximum": 90,
          "description": "Quanti giorni di posta guardare."
        },
        "bottega.posta.dominiIgnorati": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Domini da non suggerire mai per la rubrica, per esempio il tuo sito personale."
        }
      }
    },
    "colors": [
      {
        "id": "bottega.sodio",
        "description": "Lampada al sodio: sessioni Claude al lavoro e cose da spingere.",
        "defaults": {
          "dark": "#f4ab3c",
          "light": "#a85f00",
          "highContrast": "#ffb547",
          "highContrastLight": "#8a4e00"
        }
      }
    ]
  },
  "scripts": {
    "build": "esbuild src/extension.ts --bundle --platform=node --format=cjs --target=node20 --external:vscode --outfile=out/extension.js",
    "typecheck": "tsc --noEmit",
    "test": "node test/run.cjs && node test/stats.cjs && node test/regole.cjs && node test/stanze.cjs && node test/plancia.cjs && node test/idee.cjs && node test/cruscotto-ui.cjs && node test/connettori.cjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.100.0",
    "esbuild": "^0.25.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.6.0"
  }
}
