 "tokenColors": [
  {
   "scope": [
    "comment",
    "punctuation.definition.comment"
   ],
   "settings": {
    "foreground": "#7a8299",
    "fontStyle": "italic"
   }
  },
  {
   "scope": [
    "keyword",
    "storage",
    "storage.type",
    "keyword.control",
    "storage.modifier"
   ],
   "settings": {
    "foreground": "#2f55c4"
   }
  },
  {
   "scope": [
    "string",
    "string.quoted",
    "string.template"
   ],
   "settings": {
    "foreground": "#2c7549"
   }
  },
  {
   "scope": [
    "constant.character.escape",
    "string.regexp"
   ],
   "settings": {
    "foreground": "#0f7a74"
   }
  },
  {
   "scope": [
    "constant.numeric",
    "constant.language",
    "constant.other",
    "support.constant",
    "variable.other.constant"
   ],
   "settings": {
    "foreground": "#a85f00"
   }
  },
  {
   "scope": [
    "entity.name.function",
    "support.function",
    "meta.function-call entity.name.function"
   ],
   "settings": {
    "foreground": "#7d5300"
   }
  },
  {
   "scope": [
    "entity.name.type",
    "entity.name.class",
    "support.type",
    "support.class",
    "entity.other.inherited-class",
    "entity.name.namespace"
   ],
   "settings": {
    "foreground": "#0f7a74"
   }
  },
  {
   "scope": [
    "variable",
    "variable.other.readwrite",
    "meta.definition.variable"
   ],
   "settings": {
    "foreground": "#1b2440"
   }
  },
  {
   "scope": [
    "variable.parameter"
   ],
   "settings": {
    "foreground": "#4a4030",
    "fontStyle": "italic"
   }
  },
  {
   "scope": [
    "variable.other.property",
    "variable.other.object.property",
    "support.variable.property",
    "meta.object-literal.key"
   ],
   "settings": {
    "foreground": "#4b5470"
   }
  },
  {
   "scope": [
    "entity.name.tag",
    "punctuation.definition.tag"
   ],
   "settings": {
    "foreground": "#b23b25"
   }
  },
  {
   "scope": [
    "entity.other.attribute-name"
   ],
   "settings": {
    "foreground": "#7d5300"
   }
  },
  {
   "scope": [
    "keyword.operator",
    "punctuation",
    "meta.brace"
   ],
   "settings": {
    "foreground": "#5c6680"
   }
  },
  {
   "scope": [
    "markup.heading",
    "entity.name.section"
   ],
   "settings": {
    "foreground": "#a85f00",
    "fontStyle": "bold"
   }
  },
  {
   "scope": [
    "markup.bold"
   ],
   "settings": {
    "foreground": "#1b2440",
    "fontStyle": "bold"
   }
  },
  {
   "scope": [
    "markup.italic"
   ],
   "settings": {
    "foreground": "#1b2440",
    "fontStyle": "italic"
   }
  },
  {
   "scope": [
    "markup.inline.raw",
    "markup.fenced_code"
   ],
   "settings": {
    "foreground": "#2c7549"
   }
  },
  {
   "scope": [
    "markup.underline.link",
    "string.other.link"
   ],
   "settings": {
    "foreground": "#2f55c4"
   }
  },
  {
   "scope": [
    "support.type.property-name.json",
    "support.type.property-name"
   ],
   "settings": {
    "foreground": "#4b5470"
   }
  },
  {
   "scope": [
    "variable.language.this",
    "variable.language.self",
    "variable.language.super"
   ],
   "settings": {
    "foreground": "#7a3fbf",
    "fontStyle": "italic"
   }
  },
  {
   "scope": [
    "invalid"
   ],
   "settings": {
    "foreground": "#b5362a"
   }
  }
 ],
 "semanticTokenColors": {
  "enumMember": "#a85f00",
  "property.readonly": "#4b5470",
  "*.deprecated": {
   "strikethrough": true
  }
 }
}