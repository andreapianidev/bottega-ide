 "tokenColors": [
  {
   "scope": [
    "comment",
    "punctuation.definition.comment"
   ],
   "settings": {
    "foreground": "#66708a",
    "fontStyle": "italic"
   }
  },
  {
   "scope": [
    "keyword",
    "storage",
    "storage.type",
    "keyword.control",
    "storage.modifier"
   ],
   "settings": {
    "foreground": "#8fb4ff"
   }
  },
  {
   "scope": [
    "string",
    "string.quoted",
    "string.template"
   ],
   "settings": {
    "foreground": "#a9d4a0"
   }
  },
  {
   "scope": [
    "constant.character.escape",
    "string.regexp"
   ],
   "settings": {
    "foreground": "#7fd6d0"
   }
  },
  {
   "scope": [
    "constant.numeric",
    "constant.language",
    "constant.other",
    "support.constant",
    "variable.other.constant"
   ],
   "settings": {
    "foreground": "#f4ab3c"
   }
  },
  {
   "scope": [
    "entity.name.function",
    "support.function",
    "meta.function-call entity.name.function"
   ],
   "settings": {
    "foreground": "#f0d58c"
   }
  },
  {
   "scope": [
    "entity.name.type",
    "entity.name.class",
    "support.type",
    "support.class",
    "entity.other.inherited-class",
    "entity.name.namespace"
   ],
   "settings": {
    "foreground": "#7fd6d0"
   }
  },
  {
   "scope": [
    "variable",
    "variable.other.readwrite",
    "meta.definition.variable"
   ],
   "settings": {
    "foreground": "#e8e2d0"
   }
  },
  {
   "scope": [
    "variable.parameter"
   ],
   "settings": {
    "foreground": "#d8cfb8",
    "fontStyle": "italic"
   }
  },
  {
   "scope": [
    "variable.other.property",
    "variable.other.object.property",
    "support.variable.property",
    "meta.object-literal.key"
   ],
   "settings": {
    "foreground": "#c9c2ae"
   }
  },
  {
   "scope": [
    "entity.name.tag",
    "punctuation.definition.tag"
   ],
   "settings": {
    "foreground": "#ff9b85"
   }
  },
  {
   "scope": [
    "entity.other.attribute-name"
   ],
   "settings": {
    "foreground": "#f0d58c"
   }
  },
  {
   "scope": [
    "keyword.operator",
    "punctuation",
    "meta.brace"
   ],
   "settings": {
    "foreground": "#a3abc0"
   }
  },
  {
   "scope": [
    "markup.heading",
    "entity.name.section"
   ],
   "settings": {
    "foreground": "#f4ab3c",
    "fontStyle": "bold"
   }
  },
  {
   "scope": [
    "markup.bold"
   ],
   "settings": {
    "foreground": "#e8e2d0",
    "fontStyle": "bold"
   }
  },
  {
   "scope": [
    "markup.italic"
   ],
   "settings": {
    "foreground": "#e8e2d0",
    "fontStyle": "italic"
   }
  },
  {
   "scope": [
    "markup.inline.raw",
    "markup.fenced_code"
   ],
   "settings": {
    "foreground": "#a9d4a0"
   }
  },
  {
   "scope": [
    "markup.underline.link",
    "string.other.link"
   ],
   "settings": {
    "foreground": "#8fb4ff"
   }
  },
  {
   "scope": [
    "support.type.property-name.json",
    "support.type.property-name"
   ],
   "settings": {
    "foreground": "#c9c2ae"
   }
  },
  {
   "scope": [
    "variable.language.this",
    "variable.language.self",
    "variable.language.super"
   ],
   "settings": {
    "foreground": "#c6a4f5",
    "fontStyle": "italic"
   }
  },
  {
   "scope": [
    "invalid"
   ],
   "settings": {
    "foreground": "#ee7a6a"
   }
  }
 ],
 "semanticTokenColors": {
  "enumMember": "#f4ab3c",
  "property.readonly": "#c9c2ae",
  "*.deprecated": {
   "strikethrough": true
  }
 }
}